# La Cesta — ajustes para Apache
# Si despliegas la carpeta en un subdirectorio de Joomla, este archivo
# se aplica solo a esa carpeta (si AllowOverride lo permite).

DirectoryIndex index.html

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/svg+xml .svg
</IfModule>

<IfModule mod_headers.c>
  # Los archivos estáticos pueden cachearse, pero el service worker y el
  # manifiesto deben revalidarse para que las actualizaciones lleguen.
  <FilesMatch "\.(?:js|css|png|webmanifest)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
  <Files "manifest.webmanifest">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
